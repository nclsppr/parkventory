{
  "schemaVersion": 1,
  "renderer": {
    "name": "nimbus",
    "config": "docs-nimbus/astro.config.ts"
  },
  "collections": [
    {
      "id": "project",
      "title": "Contrat du projet",
      "visibility": "internal",
      "include": ["*.md", "frontend/PRODUCT.md"]
    },
    {
      "id": "product",
      "title": "Produit",
      "visibility": "public",
      "include": ["docs/product/**/*.md"]
    },
    {
      "id": "architecture",
      "title": "Architecture et sécurité",
      "visibility": "internal",
      "include": ["docs/architecture/**/*.md"]
    },
    {
      "id": "working-notes",
      "title": "Questions de travail",
      "visibility": "internal",
      "include": ["docs/internal/**/*.md"]
    },
    {
      "id": "agent-skills",
      "title": "Configuration des skills",
      "visibility": "internal",
      "include": ["docs/agents/**/*.md"]
    },
    {
      "id": "decisions",
      "title": "Décisions",
      "visibility": "internal",
      "include": ["docs/decisions/**/*.md"]
    },
    {
      "id": "visual-references",
      "title": "Références visuelles",
      "visibility": "reference",
      "include": ["docs/references/**/*.md"]
    },
    {
      "id": "foundation",
      "title": "Socle vendorisé",
      "visibility": "reference",
      "include": ["docs/foundation/**/*.md"]
    },
    {
      "id": "nimbus-maintenance",
      "title": "Maintenance Nimbus",
      "visibility": "reference",
      "include": ["docs-nimbus/AGENT.md"]
    }
  ],
  "ignored": [
    {
      "pattern": "node_modules/**/*.md",
      "reason": "Dépendances tierces"
    },
    {
      "pattern": "dist/**/*.md",
      "reason": "Sorties générées"
    },
    {
      "pattern": "frontend/dist/**/*.md",
      "reason": "Artefact GitHub Pages combiné généré"
    },
    {
      "pattern": "build/**/*.md",
      "reason": "Sorties générées"
    },
    {
      "pattern": ".venv/**/*.md",
      "reason": "Environnement Python local"
    },
    {
      "pattern": "docs-nimbus/src/content/docs/**/*.md",
      "reason": "Collection Nimbus générée depuis les sources classées"
    },
    {
      "pattern": "docs-nimbus/node_modules/**/*.md",
      "reason": "Dépendances Nimbus tierces"
    },
    {
      "pattern": "docs-nimbus/dist/**/*.md",
      "reason": "Site Nimbus généré"
    }
  ]
}
