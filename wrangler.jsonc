{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parkventory",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parkventory-preview",
      "database_id": "9623bf62-4144-48c5-aa32-343f393e926a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "preview",
    "EMAIL_FROM": "Parkventory <noreply@parkventory.com>",
    "PUBLIC_ORIGIN": ""
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@parkventory.com"]
    }
  ],
  "secrets": {
    "required": ["APP_SECRET", "TURNSTILE_SECRET_KEY", "GODMODE_ADMIN_EMAIL_SHA256"]
  },
  "env": {
    "production": {
      "name": "parkventory-production",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "directory": "./frontend/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "routes": [
        {
          "pattern": "parkventory.com",
          "custom_domain": true
        },
        {
          "pattern": "www.parkventory.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "parkventory-production",
          "database_id": "07118826-b935-4f87-9fca-a5d1e6a01218",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "EMAIL_FROM": "Parkventory <noreply@parkventory.com>",
        "PUBLIC_ORIGIN": "https://parkventory.com"
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@parkventory.com"]
        }
      ],
      "secrets": {
        "required": ["APP_SECRET", "TURNSTILE_SECRET_KEY", "GODMODE_ADMIN_EMAIL_SHA256"]
      }
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
