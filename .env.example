# PostgreSQL local
PARKVENTORY_DB_PORT=5434
PARKVENTORY_DB_NAME=parkventory
PARKVENTORY_DB_USER=parkventory
PARKVENTORY_DB_PASSWORD=parkventory-local-only

# Mailpit local
PARKVENTORY_MAILPIT_SMTP_PORT=1025
PARKVENTORY_MAILPIT_UI_PORT=8025

# Quarkus
PARKVENTORY_JDBC_URL=jdbc:postgresql://localhost:5434/parkventory
PARKVENTORY_API_PORT=8080

# Frontend
VITE_API_BASE_URL=/api/v1
# Valeurs utilisées par la publication GitHub Pages, inutiles en local :
# VITE_BASE_PATH=/parkventory/
# VITE_DEMO_MODE=true
# La release VPS force VITE_AUTH_MODE=oidc au build. Le local conserve magic-link.

# Production VPS (valeurs non secrètes)
# PARKVENTORY_OIDC_AUTH_SERVER_URL=https://TENANT.eu.auth0.com/
# PARKVENTORY_OIDC_ISSUER=https://TENANT.eu.auth0.com/
# PARKVENTORY_OIDC_CLIENT_ID=CLIENT_ID
# Les trois secrets correspondants sont montés depuis /etc/vps/secrets/parkventory/ :
# parkventory-oidc-client-secret, parkventory-oidc-state-secret,
# parkventory-oidc-token-encryption-secret. Ne pas les placer dans ce fichier.
# PARKVENTORY_SMTP_FROM=Parkventory <no-reply@notifications.parkventory.com>
# PARKVENTORY_SMTP_HOST=smtp.resend.com
# PARKVENTORY_SMTP_PORT=587
# L'utilisateur SMTP `resend` et sa clé dédiée restent dans les fichiers secrets
# parkventory-smtp-username et parkventory-smtp-password sur Atlas.
