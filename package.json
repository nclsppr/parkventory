{
  "name": "parkventory",
  "version": "0.2.0",
  "private": true,
  "description": "Partage de places de parking entre collègues, sur Cloudflare.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:frontend": "npm run dev --workspace @parkventory/frontend",
    "build": "npm run build --workspace @parkventory/frontend",
    "brand:sync": "node scripts/sync_brand_assets.mjs",
    "brand:check": "node scripts/sync_brand_assets.mjs --check",
    "test:brand": "node --test scripts/localized_brand_assets.test.mjs scripts/social_card.test.mjs",
    "test:migrations": "node --test scripts/migrations.test.mjs",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test": "npm run test:brand && npm run test:migrations && npm run build && vitest run --config worker/vitest.config.ts && npm run test --workspace @parkventory/frontend",
    "verify": "npm run brand:check && npm run test && npm run typecheck:worker && wrangler deploy --env=\"\" --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "deploy": "npm run build && wrangler deploy",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "cf:types": "wrangler types --env production worker/worker-configuration.d.ts --include-runtime false"
  },
  "dependencies": {
    "hono": "4.13.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260823.1",
    "@types/node": "26.2.0",
    "opentype.js": "2.0.0",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  }
}
