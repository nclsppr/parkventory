{
  "name": "parkventory",
  "version": "0.2.0",
  "private": true,
  "description": "Partage de places de parking entre collègues, sur Cloudflare.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:frontend": "npm run dev --workspace @parkventory/frontend",
    "build": "npm run build --workspace @parkventory/frontend",
    "test": "vitest run --config worker/vitest.config.ts && npm run test --workspace @parkventory/frontend",
    "verify": "npm run test && npm run build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types worker/worker-configuration.d.ts --include-runtime false"
  },
  "dependencies": {
    "hono": "4.13.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260823.1",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  }
}
